#!/usr/bin/env python3
"""Fetch GitHub Copilot quota for the bobbyw_jsi account and print one JSON record.

On success, prints {"plan", "quotaResetDate", "recentDays": [{"date", "creditsUsed"}, ...]} to
stdout and exits 0. `recentDays` is derived locally: the copilot_internal/user endpoint only ever
returns a cumulative total for the current billing period, never a daily breakdown, so this script
samples that total on every run into a small local history cache
($XDG_CACHE_HOME/bwright.ai-usage/copilot-history.json) and computes day-over-day deltas from it.
That cache holds only ISO dates and integer credit totals -- never the token, a header, or a raw
API response -- and a failure to read/write it (missing, corrupt, unwritable) degrades to "no
historical days yet," never to the failure path below, which is reserved for the quota fetch
itself. On any fetch failure, prints a fixed, credential-free diagnostic to stderr and exits 1 --
never partial JSON, never raw subprocess/HTTP output, never a token or header value.
"""
import datetime
import fcntl
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

GH_HOSTNAME = "github.com"
GH_USER = "bobbyw_jsi"
API_URL = "https://api.github.com/copilot_internal/user"
QUOTA_CATEGORIES = ("chat", "completions", "premium_interactions")
TOKEN_OVERRIDE_VARS = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")

# VS Code Copilot Chat's own request shape -- this undocumented endpoint
# responds only to callers that look like it.
REQUEST_HEADERS = {
    "Editor-Version": "vscode/1.95.0",
    "Editor-Plugin-Version": "copilot-chat/0.23.0",
    "User-Agent": "GitHubCopilotChat/0.23.0",
    "X-GitHub-Api-Version": "2025-04-01",
}

CACHE_NAMESPACE = "bwright.ai-usage"
HISTORY_FILENAME = "copilot-history.json"
HISTORY_RETENTION_DAYS = 8  # enough distinct calendar dates to derive 7 daily deltas


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuses every redirect, same-host or not. A 3xx becomes an HTTPError
    the caller turns into the unavailable state, never a second request."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def credential_env():
    env = dict(os.environ)
    for var in TOKEN_OVERRIDE_VARS:
        env.pop(var, None)
    return env


def get_token():
    try:
        result = subprocess.run(
            ["gh", "auth", "token", "--hostname", GH_HOSTNAME, "--user", GH_USER],
            capture_output=True,
            shell=False,
            env=credential_env(),
            text=True,
        )
    except FileNotFoundError:
        fail("Copilot unavailable: gh not installed")
    if result.returncode != 0:
        fail("Copilot unavailable: no stored credential")
    token = result.stdout.strip()
    if not token:
        fail("Copilot unavailable: no stored credential")
    return token


def fetch_quota(token, url=API_URL):
    opener = urllib.request.build_opener(NoRedirectHandler)
    headers = dict(REQUEST_HEADERS)
    headers["Authorization"] = "token " + token
    request = urllib.request.Request(url, headers=headers)
    try:
        response = opener.open(request, timeout=10)
    except urllib.error.HTTPError as e:
        fail("Copilot unavailable: HTTP " + str(e.code))
    except urllib.error.URLError:
        fail("Copilot unavailable: request failed")
    try:
        body = response.read()
    finally:
        response.close()
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        fail("Copilot unavailable: malformed response")


def parse_quota(payload):
    try:
        snapshots = payload["quota_snapshots"]
        total = sum(int(snapshots[name]["credits_used"]) for name in QUOTA_CATEGORIES)
        return {
            "plan": payload["copilot_plan"],
            "quotaResetDate": payload["quota_reset_date"],
            "totalCreditsUsed": total,
        }
    except (KeyError, TypeError):
        fail("Copilot unavailable: unexpected response shape")


# --------------------------------------------------------- daily-history bookkeeping


def history_path():
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    return Path(base) / CACHE_NAMESPACE / HISTORY_FILENAME


def local_today_string():
    return datetime.date.today().isoformat()


def prune_history(history, keep=HISTORY_RETENTION_DAYS):
    kept_dates = sorted(history, reverse=True)[:keep]
    return {date: history[date] for date in kept_dates}


def compute_recent_days(history):
    """Turn a {date: cumulative_total} history into day-over-day deltas, oldest first,
    capped at the last 7. The earliest date in `history` has no prior sample to diff
    against and is never emitted. A delta that would be negative (a billing-period
    reset dropped the cumulative total) is clamped to the raw post-reset value instead."""
    dates = sorted(history)
    days = []
    for i in range(1, len(dates)):
        delta = history[dates[i]] - history[dates[i - 1]]
        if delta < 0:
            delta = history[dates[i]]
        days.append({"date": dates[i], "creditsUsed": delta})
    return days[-7:]


def sample_history(path, today, total_now, keep=HISTORY_RETENTION_DAYS):
    """Record `total_now` as `today`'s cumulative snapshot under an exclusive file lock
    (guards against the refresh timer and a manual refresh overlapping), prune to the
    last `keep` calendar dates, and return the resulting history dict. Creates the file
    and its parent directory if missing; a corrupt or empty existing file is treated as
    an empty history rather than raised."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            f.seek(0)
            raw = f.read()
            try:
                history = json.loads(raw) if raw.strip() else {}
            except json.JSONDecodeError:
                history = {}
            if not isinstance(history, dict):
                history = {}
            history[today] = total_now
            history = prune_history(history, keep)
            f.seek(0)
            f.truncate()
            json.dump(history, f)
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)
    return history


def recent_days_for(total_now, today):
    """Best-effort day-by-day credits history: sample `total_now` into the local cache
    and return the resulting deltas. Any failure here (unwritable cache, corrupt file,
    permissions) degrades to no historical days -- this must never turn a successful
    quota fetch into a failed command; that failure path is reserved for the fetch
    itself."""
    try:
        history = sample_history(history_path(), today, total_now)
        return compute_recent_days(history)
    except Exception:
        return []


def main():
    # A stray, truly-unexpected exception (not one of the specific failure
    # paths above, which already exit via fail()) must still never reach
    # stderr as a raw traceback -- that could echo back request/response
    # internals. sys.exit()'s SystemExit isn't an Exception subclass, so the
    # fail() calls above pass through this untouched.
    try:
        token = get_token()
        payload = fetch_quota(token)
        quota = parse_quota(payload)
        today = local_today_string()
        recent_days = recent_days_for(quota["totalCreditsUsed"], today=today)
        # Mirrors the collector's own todayPrompts/todaySessions/todayTotalTokens
        # fields for Claude -- the caller gets "today" as a plain value, never
        # has to date-compare recentDays itself. -1 is this codebase's existing
        # "not available" sentinel (see e.g. Panel.qml's MeterRow meterValue).
        today_credits_used = (
            recent_days[-1]["creditsUsed"]
            if recent_days and recent_days[-1]["date"] == today
            else -1
        )
        record = {
            "plan": quota["plan"],
            "quotaResetDate": quota["quotaResetDate"],
            "recentDays": recent_days,
            "todayCreditsUsed": today_credits_used,
        }
        print(json.dumps(record))
    except Exception:
        fail("Copilot unavailable: unexpected error")


if __name__ == "__main__":
    main()

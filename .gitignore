# Never commit anything credential-shaped. This repo can double as the live
# plugin directory (symlinked into ~/.config/omarchy/plugins/) and is pushed to
# a public GitHub remote — nothing the plugin writes at runtime should exist
# here in the first place, but this is defense-in-depth against an accidental
# stray file.
.env
*.token
*credentials*
*.log

# Python test/bytecode artifacts from running the pytest suite locally.
__pycache__/
*.pyc
.pytest_cache/
